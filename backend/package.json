{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test src/modules/seasons/season.rules.test.ts src/modules/seasons/season.completion.test.ts src/modules/seasons/season.service.test.ts src/modules/seasonTeams/seasonTeam.withdrawal.test.ts src/modules/seasonAwards/seasonAward.readiness.test.ts src/modules/matches/seasonMatch.qualification.test.ts src/modules/matches/seasonMatch.fixtureRules.test.ts src/modules/matches/seasonMatch.statusRules.test.ts src/modules/players/player.schema.test.ts src/modules/players/player.service.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "migrate:team-groups": "tsx src/scripts/migrateLegacyTeamGroupName.ts",
    "migrate:season-dates": "tsx src/scripts/migrateSeasonDateFields.ts",
    "migrate:season-identities": "tsx src/scripts/migrateSeasonIdentityFields.ts",
    "migrate:player-auction-fields": "tsx src/scripts/migrateLegacyPlayerAuctionFields.ts",
    "migrate:player-auction-fields:apply": "tsx src/scripts/migrateLegacyPlayerAuctionFields.ts --apply",
    "migrate:season-fixture-venues": "tsx src/scripts/migrateSeasonFixtureVenues.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
